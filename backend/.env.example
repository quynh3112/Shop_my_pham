# Copy file này thành .env rồi điền thông tin của máy mình

# Kết nối PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=lunelle

# SMTP dùng để gửi OTP (Gmail: smtp.gmail.com, cổng 587, SMTP_SECURE=false)
# SMTP_PASS với Gmail là App Password 16 ký tự (KHÔNG phải mật khẩu Gmail)
#   Tạo tại https://myaccount.google.com/apppasswords (tài khoản phải bật xác minh 2 bước)
# Để trống SMTP_HOST/SMTP_USER/SMTP_PASS khi dev thì OTP được in ra console của backend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=LUNELLE

# OTP gửi qua email
EMAIL_OTP_TTL_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60

# Tài khoản admin tạo bởi `npm run seed`
# Nên đặt email thật để nhận được OTP khi quên mật khẩu
SEED_ADMIN_EMAIL=admin@lunelle.vn
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_PHONE=0900000000

# Chat AI (Google Gemini) - lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Model dự phòng khi model chính quá tải (cách nhau bởi dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest

# Phân tích da bằng ảnh (dùng chung GEMINI_API_KEY ở trên)
# Model riêng cho phân tích da (để trống = dùng GEMINI_MODEL)
SKIN_ANALYSIS_MODEL=
# Số lượt phân tích tối đa mỗi người trong 24 giờ
SKIN_ANALYSIS_DAILY_LIMIT=10

# Thanh toán MoMo: để trống / sandbox = MoMo giả lập (không trừ tiền thật); live = cổng thật (chưa đấu nối)
MOMO_MODE=sandbox
